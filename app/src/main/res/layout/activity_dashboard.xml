<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F8FC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="28dp"
        android:paddingEnd="22dp"
        android:paddingBottom="30dp">

        <!-- Greeting -->
        <TextView
            android:id="@+id/welcomeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Good morning"
            android:textColor="#1D1D1F"
            android:textSize="28sp"
            android:textStyle="bold"
            android:letterSpacing="-0.02"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Financial overview"
            android:textColor="#86868B"
            android:textSize="15sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="30dp" />


        <!-- Balance Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AVAILABLE BALANCE"
            android:textColor="#86868B"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginBottom="5dp" />

        <TextView
            android:id="@+id/balanceText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="KSh 0.00"
            android:textColor="#1D1D1F"
            android:textSize="36sp"
            android:textStyle="bold"
            android:letterSpacing="-0.03" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your recorded income minus expenses"
            android:textColor="#86868B"
            android:textSize="14sp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="26dp" />


        <!-- Income / Expense Summary -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Income -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="105dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="17dp"
                android:background="#FFFFFF"
                android:elevation="1dp"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="INCOME"
                    android:textColor="#86868B"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06" />

                <TextView
                    android:id="@+id/totalIncomeText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="KSh 0.00"
                    android:textColor="#248A3D"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="10dp" />

            </LinearLayout>


            <!-- Expenses -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="105dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="17dp"
                android:background="#FFFFFF"
                android:elevation="1dp"
                android:layout_marginStart="6dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="EXPENSES"
                    android:textColor="#86868B"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06" />

                <TextView
                    android:id="@+id/totalExpensesText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="KSh 0.00"
                    android:textColor="#D70015"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="10dp" />

            </LinearLayout>

        </LinearLayout>


        <!-- Quick Actions -->
<TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="QUICK ACTIONS"
    android:textColor="#86868B"
    android:textSize="12sp"
    android:textStyle="bold"
    android:letterSpacing="0.08"
    android:layout_marginTop="32dp"
    android:layout_marginBottom="12dp" />

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <Button
        android:id="@+id/addTransactionButton"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_weight="1"
        android:text="+  Add Transaction"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:backgroundTint="#007AFF"
        android:layout_marginEnd="6dp" />

    <Button
        android:id="@+id/viewHistoryButton"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_weight="1"
        android:text="View Activity"
        android:textColor="#007AFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:backgroundTint="#E5F1FF"
        android:layout_marginStart="6dp" />

</LinearLayout>

<!-- Privacy & Security Actions -->
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_marginTop="10dp">

    <Button
        android:id="@+id/toggleAmountsButton"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:text="👁  Hide Amounts"
        android:textColor="#1D1D1F"
        android:textSize="13sp"
        android:backgroundTint="#E8F1F8"
        android:layout_marginEnd="6dp" />

    <Button
        android:id="@+id/lockAppButton"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:text="🔒  Lock App"
        android:textColor="#1D1D1F"
        android:textSize="13sp"
        android:backgroundTint="#E8F1F8"
        android:layout_marginStart="6dp" />

</LinearLayout>
        <!-- Recent Activity -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RECENT ACTIVITY"
            android:textColor="#86868B"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginTop="34dp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="18dp"
            android:elevation="1dp">

            <TextView
                android:id="@+id/recentActivityText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No recent transactions"
                android:textColor="#1D1D1F"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/recentActivityHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your latest financial activity will appear here."
                android:textColor="#86868B"
                android:textSize="13sp"
                android:layout_marginTop="5dp" />

        </LinearLayout>


        <!-- Security Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="20dp"
            android:paddingBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="●"
                android:textColor="#248A3D"
                android:textSize="14sp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Your records are protected"
                android:textColor="#1D1D1F"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/securityStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SECURE"
                android:textColor="#248A3D"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- Footer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="FINANCIAL RECORD MANAGEMENT"
            android:textAlignment="center"
            android:textColor="#AEAEB2"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginTop="22dp" />

    </LinearLayout>

</ScrollView>